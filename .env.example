# Required: who you are (no defaults — must be set)
SCHEDULER_OWNER_NAME=Your Name
SCHEDULER_OWNER_EMAIL=you@example.com
SCHEDULER_OWNER_TIMEZONE=America/New_York

# Optional: any of these will override the matching value in /config.js.
# Defaults are defined in /config.js — only set what you want to change.
#
# SCHEDULER_THEME=minimal                # 'minimal' | 'warm' | 'dark'
# SCHEDULER_LANGUAGE=en                  # reserved for future i18n
# SCHEDULER_BOOKING_WINDOW_DAYS=30
# SCHEDULER_AVAILABILITY={"days":[1,2,3,4,5],"startHour":9,"endHour":17,"bufferMinutes":15}
# SCHEDULER_MEETING_TYPES=[{"slug":"intro","name":"Intro Call","duration":30,"description":"...","questions":[]}]

# Google Calendar API — see README "Google Calendar OAuth"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Resend — for transactional emails (resend.com)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Random secret used to sign accept/decline action links sent in the owner
# notification email. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCHEDULER_SIGNING_SECRET=
