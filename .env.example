# Google Calendar API — get from Google Cloud Console (see README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Calendar to use as source of truth. "primary" uses the authenticated user's
# default calendar, or set to a specific calendar email/id.
GOOGLE_CALENDAR_ID=primary

# Resend API key — for sending confirmation emails (resend.com)
RESEND_API_KEY=

# Domain to send transactional emails from (must be verified in Resend).
# For local dev / before domain verification, you can use "onboarding@resend.dev".
RESEND_FROM=onboarding@resend.dev
